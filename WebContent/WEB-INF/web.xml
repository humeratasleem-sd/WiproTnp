        </servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ChangePasswordModuleServlet</servlet-name>

        <url-pattern>/changePasswordModule</url-pattern>
    </servlet-mapping>


    <!-- Starting Page -->

    <welcome-file-list>
        <welcome-file>ServletLoginModule/Login.html</welcome-file>
    </welcome-file-list>

    <!-- TM14 - Library Management Using AJAX - Email Check -->

<servlet>
    <servlet-name>LibraryEmailCheckServlet</servlet-name>

    <servlet-class>
        TM01.AJAXLibraryManagement.EmailCheckServlet
