    </servlet>

    <servlet-mapping>
        <servlet-name>DisplayCookiesServlet</servlet-name>

        <url-pattern>/cookies</url-pattern>
    </servlet-mapping>


    <!-- Servlet - Cookies and Session Management - Problem 3 -->

    <servlet>
