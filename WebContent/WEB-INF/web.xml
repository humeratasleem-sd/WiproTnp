<!-- TM14 - Library Management Using AJAX - Login -->

<servlet>
    <servlet-name>LibraryLoginServlet</servlet-name>

    <servlet-class>
        TM01.AJAXLibraryManagement.LoginServlet
    </servlet-class>
</servlet>

<servlet-mapping>
